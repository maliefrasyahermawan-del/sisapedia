SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
PREVIEW_MODE=true
# Preview Sari uses OmniRoute first, then its deterministic local fallback.
# Pass these at build/run time with --dart-define; never commit the token.
OMNIROUTE_APP_SECRET=
OMNIROUTE_BASE_URL=https://counting-christine-geometry-tricks.trycloudflare.com/v1/chat/completions
OMNIROUTE_MODEL=antigravity/gemini-3.6-flash-high
# Backend-only Edge Function secrets (never put these in Flutter/.env):
# NINJA_API_KEY=...
# ROUTER_BASE_URL=https://api.9router.com/v1/chat/completions
# ROUTER_MODEL=gpt-4o-mini

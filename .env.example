GROQ_API_KEY=your_groq_api_key_here

# Up to 3 Gemini API keys for "Setor Cerdas" Mode Foto (Google AI Studio).
# All optional to fill in — leave blank if you don't have one yet. When
# GEMINI_API_KEY_1 hits a rate limit/quota error, the service automatically
# falls back to _2, then _3, before showing an error.
GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
